.profile-page { padding-top: 37rpx; }
.page-eyebrow { display: block; color: #8b9c8d; font-size: 19rpx; font-weight: 600; letter-spacing: 2.3rpx; }
.profile-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 29rpx; margin-bottom: 36rpx; }
.profile-heading-title { display: block; font-size: 48rpx; font-weight: 600; color: #214431; letter-spacing: -1.5rpx; }
.profile-heading-description { display: block; font-size: 23rpx; margin-top: 16rpx; color: #8c9c8d; }
.profile-leaf { height: 75rpx; width: 75rpx; border: 1rpx solid #d7e5d8; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.profile-leaf view { width: 26rpx; height: 36rpx; background: #bbd8b3; border-radius: 0 25rpx 0 25rpx; transform: rotate(27deg); }
.account-card { background: #fff; padding: 31rpx; border: 1rpx solid #e4ede3; border-radius: 26rpx; }
.account-top { display: flex; align-items: center; }.avatar { background: #e7f2e3; color: #6b9c62; width: 96rpx; height: 96rpx; border-radius: 29rpx; display: flex; align-items: center; justify-content: center; font-size: 43rpx; font-weight: 500; font-family: Arial, sans-serif; position: relative; margin-right: 25rpx; flex-shrink: 0; }.avatar-dot { background: #7fb56c; border: 4rpx solid #fff; width: 14rpx; height: 14rpx; border-radius: 50%; position: absolute; right: -2rpx; bottom: 4rpx; }
.account-copy { flex: 1; min-width: 0; }.account-name-row { display: flex; align-items: center; flex-wrap: wrap; }.account-name { color: #385b3d; font-size: 31rpx; font-weight: 500; }.account-description { display: block; color: #9aa792; font-size: 21rpx; line-height: 1.6; margin-top: 11rpx; }.demo-badge { color: #8ba778; background: #f0f6e9; padding: 4rpx 8rpx; font-size: 16rpx; border-radius: 6rpx; margin-left: 12rpx; letter-spacing: 1rpx; }
.login-button { background: #07a66a; color: #fff; border-radius: 16rpx; border: 0; margin-top: 29rpx; padding: 21rpx; font-size: 26rpx; line-height: 1.5; font-weight: 500; display: flex; align-items: center; justify-content: center; }.login-button text { margin-left: 19rpx; font-size: 29rpx; }.login-button::after,.logout-button::after,.tool-row::after,.profile-error button::after { border: 0; }.login-button[disabled] { color: #e1f4e7; background: #60b88b; }
.logout-button { background: #f4f8f0; color: #769263; border: 1rpx solid #e4eddc; border-radius: 16rpx; padding: 20rpx; margin-top: 29rpx; font-size: 24rpx; line-height: 1.5; }.logout-button text { margin-left: 20rpx; }
.demo-note { display: flex; align-items: center; justify-content: center; color: #aab59f; font-size: 19rpx; margin-top: 21rpx; }.note-dot { width: 6rpx; height: 6rpx; background: #bcc9ac; border-radius: 50%; margin-right: 10rpx; }
.profile-error { display: flex; align-items: center; justify-content: space-between; font-size: 21rpx; margin-top: 18rpx; color: #b09670; }.profile-error button { background: transparent; color: #8a986b; margin: 0; padding: 5rpx 10rpx; font-size: 21rpx; line-height: 1.6; }
.info-section { margin-top: 44rpx; }.info-card { background: #fff; padding: 0 28rpx; border: 1rpx solid #e4ece0; border-radius: 24rpx; }.info-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid #eff2e9; }.info-row.last { border: 0; }.info-label { display: flex; align-items: center; color: #5d7652; font-size: 25rpx; }.info-symbol { font-size: 28rpx; color: #a1b18a; width: 40rpx; text-align: center; margin-right: 20rpx; font-weight: 400; }.code-symbol { font-family: monospace; font-size: 23rpx; }
.env-tag { display: flex; align-items: center; color: #86a268; background: #f1f6e9; padding: 7rpx 13rpx; border-radius: 8rpx; font-size: 20rpx; }.env-tag view { height: 6rpx; width: 6rpx; border-radius: 50%; background: #8fb775; margin-right: 9rpx; }.info-value { color: #a0ad90; font-size: 23rpx; }.version-value { color: #a2b08f; font-size: 23rpx; font-family: Arial, sans-serif; }
.tool-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; margin: 0; border: 0; border-bottom: 1rpx solid #eff2e9; border-radius: 0; background: #fff; line-height: 1.5; }.tool-row.last { border: 0; }.tool-row[disabled] { opacity: .5; background: #fff; }.row-arrow { color: #bbc8a9; font-size: 27rpx; }.about-symbol { font-family: Georgia, serif; font-style: italic; font-size: 30rpx; }
.quote-card { margin-top: 35rpx; padding: 30rpx 30rpx; background: #edf3e7; border: 1rpx solid #e4ecdc; border-radius: 22rpx; }.quote-mark { display: block; font-family: Georgia, serif; line-height: .9; color: #adc49a; font-size: 66rpx; margin-bottom: 5rpx; }.quote-text { display: block; color: #78945f; font-size: 29rpx; line-height: 1.8; font-weight: 400; letter-spacing: 2rpx; }.quote-bottom { display: flex; align-items: center; margin-top: 21rpx; font-size: 16rpx; letter-spacing: 2rpx; color: #a6b694; }.quote-bottom view { width: 23rpx; height: 1rpx; background: #b7c8a3; margin-right: 12rpx; }
.brand-footer { display: flex; align-items: center; justify-content: center; color: #aebba2; font-size: 18rpx; letter-spacing: 2rpx; padding: 45rpx 0 15rpx; gap: 10rpx; }.brand-mark { font-family: Arial, sans-serif; font-weight: 600; font-size: 23rpx; color: #99b183; position: relative; }.brand-mark view { width: 9rpx; height: 6rpx; border-radius: 0 6rpx 0 6rpx; background: #aec599; position: absolute; right: -7rpx; top: 0; }.brand-footer-dot { margin: 0 4rpx; color: #c3ccb9; }
.button-hover,.row-hover { opacity: .65; }
