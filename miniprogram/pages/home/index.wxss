.home-page { padding-top: 34rpx; }
.brand-row { display: flex; justify-content: space-between; align-items: center; }
.eyebrow { color: #7e9084; font-size: 19rpx; font-weight: 600; letter-spacing: 2.5rpx; }
.live-tag { display: flex; align-items: center; color: #508a6d; font-size: 20rpx; }
.live-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #07a66a; margin-right: 10rpx; }
.hero { padding: 45rpx 0 36rpx; }
.hero-title { font-size: 60rpx; line-height: 1.42; font-weight: 600; letter-spacing: -2.5rpx; color: #183a2b; }
.green-text { color: #07a66a; }
.hero-description { display: block; margin-top: 17rpx; color: #8b998f; font-size: 25rpx; letter-spacing: 1rpx; }
.home-map-section { margin: 6rpx 0 36rpx; }
.map-hint { display: block; margin-top: 14rpx; text-align: center; color: #8b998f; font-size: 21rpx; }
.ready-card { padding: 31rpx 34rpx 27rpx; border-radius: 28rpx; background: #0b4c38; color: #fff; overflow: hidden; position: relative; }
.ready-top { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 1; }
.ready-icon { height: 58rpx; width: 58rpx; background: #1c654c; border: 1rpx solid #34795f; border-radius: 19rpx; display: flex; align-items: center; justify-content: center; color: #b2efbe; font-size: 31rpx; }
.ready-badge { font-size: 17rpx; color: #afcdb9; letter-spacing: 2rpx; }
.ready-title { display: block; position: relative; z-index: 1; font-size: 38rpx; font-weight: 500; margin-top: 28rpx; letter-spacing: 1rpx; }
.ready-description { display: block; position: relative; z-index: 1; margin-top: 13rpx; font-size: 23rpx; color: #a9c8b8; }
.ready-bottom { position: relative; z-index: 1; border-top: 1rpx solid #39745b; margin-top: 29rpx; padding-top: 21rpx; display: flex; justify-content: space-between; color: #b1cbbc; font-size: 20rpx; }
.orbit { position: absolute; border: 1rpx solid #397259; border-radius: 50%; width: 410rpx; height: 410rpx; right: -197rpx; top: -60rpx; opacity: .65; }
.orbit-two { width: 320rpx; height: 320rpx; right: -149rpx; top: -15rpx; }
.stats-row { display: flex; margin: 32rpx 0 53rpx; }
.stat { width: 33.333%; text-align: center; border-right: 1rpx solid #dfe8e1; }
.stat:last-child { border-right: 0; }
.stat-value { display: block; color: #244334; font-size: 40rpx; font-weight: 600; font-family: Arial, sans-serif; }
.stat-unit { font-size: 21rpx; color: #97ada0; vertical-align: 7rpx; margin-left: 3rpx; }
.stat-label { display: block; font-size: 21rpx; margin-top: 7rpx; color: #8c9b91; }
.feature-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.feature-card { box-sizing: border-box; width: calc(50% - 9rpx); padding: 26rpx 24rpx; background: #fff; border: 1rpx solid #e8eee8; border-radius: 22rpx; margin-bottom: 18rpx; }
.feature-symbol { display: flex; align-items: center; justify-content: center; width: 59rpx; height: 59rpx; font-size: 32rpx; border-radius: 18rpx; margin-bottom: 21rpx; font-weight: 400; }
.green { background: #eaf6ed; color: #449973; }.purple { background: #f0edf9; color: #9981bf; }.blue { background: #edf3fa; color: #749abc; }.orange { background: #fbf0e6; color: #c69d6e; }
.feature-title { display: block; color: #2b4638; font-weight: 500; font-size: 28rpx; }
.feature-description { display: block; color: #94a096; font-size: 21rpx; line-height: 1.7; margin-top: 10rpx; }
.loading-label { text-align: center; color: #90a095; font-size: 21rpx; padding: 12rpx; }
.error-card { background: #fff; border-radius: 24rpx; border: 1rpx solid #e4ece5; }
.request-card { margin-top: 15rpx; padding: 27rpx; border: 1rpx solid #dce9df; border-radius: 23rpx; background: #eef5ef; }
.request-title-row { display: flex; align-items: center; }
.code-icon { font-size: 27rpx; color: #5b9272; margin-right: 22rpx; font-family: monospace; }
.request-copy { flex: 1; }.request-title { display: block; color: #32523d; font-size: 27rpx; font-weight: 500; }
.request-description { display: block; font-size: 20rpx; color: #90a08e; margin-top: 7rpx; }
.request-button { display: flex; align-items: center; justify-content: center; width: 100%; padding: 20rpx; margin-top: 23rpx; font-size: 25rpx; line-height: 1.5; background: #fff; border: 1rpx solid #e0e8e1; border-radius: 15rpx; color: #347b56; font-weight: 500; }
.request-button::after { border: 0; }.request-button text { margin-left: 19rpx; }.request-button[disabled] { color: #789783; background: #f8faf8; }
.request-result { display: block; margin-top: 18rpx; text-align: center; color: #72937b; font-size: 21rpx; }
.guide-card { margin-top: 35rpx; display: flex; padding: 27rpx 4rpx; align-items: flex-start; }
.guide-index { color: #a9b5aa; font-family: Arial, sans-serif; border: 1rpx solid #dce5dc; border-radius: 50%; width: 47rpx; height: 47rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; margin-right: 21rpx; flex-shrink: 0; }
.guide-title { display: block; font-size: 27rpx; font-weight: 500; color: #526b56; margin-top: 3rpx; }.guide-description { display: block; font-size: 22rpx; color: #95a291; line-height: 1.7; margin-top: 10rpx; }
.copy-link { display: inline-block; font-size: 21rpx; background: transparent; color: #4a8a64; margin: 14rpx 0 0; padding: 0; line-height: 1.7; }.copy-link::after { border: 0; }.copy-link text { margin-left: 10rpx; }
.page-footer { display: flex; justify-content: center; align-items: center; gap: 17rpx; color: #b0bbb1; font-size: 19rpx; letter-spacing: 2rpx; padding: 33rpx 0 18rpx; }.footer-line { width: 30rpx; height: 1rpx; background: #d4ded4; }
.button-hover,.link-hover { opacity: .65; }
