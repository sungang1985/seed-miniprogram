<view class="page home-page">
  <view class="brand-row"><text class="eyebrow">SEED / MINI PROGRAM</text><view class="live-tag"><view class="live-dot"></view>运行就绪</view></view>

  <view class="hero">
    <view class="hero-title"><view>迈出的每一步，</view><view>都有<text class="green-text">迹可循。</text></view></view>
    <text class="hero-description">开始一段运动，让地图记录你的每一步。</text>
  </view>

  <view class="home-map-section">
    <section-heading eyebrow="MOVE / LIVE TRACK" title="实时运动轨迹" />
    <location-map
      latitude="{{mapLocation.latitude}}"
      longitude="{{mapLocation.longitude}}"
      scale="{{mapLocation.scale}}"
      title="{{mapLocation.title}}"
      address="{{mapLocation.address}}"
      polyline="{{trackPolyline}}"
      live-location="{{trackLocation}}"
      tracking="{{trackActive}}"
      extra-markers="{{friendMarkers}}"
      height="{{440}}"
      bind:markertap="onMapMarkerTap"
    />
    <view class="motion-panel">
      <view class="motion-status-row">
        <view class="motion-status status-{{track.status}}"><view class="motion-status-dot"></view><text>{{track.statusLabel}}</text></view>
        <text class="motion-signal">精度 {{track.accuracyText}}</text>
      </view>

      <view class="motion-main-stats">
        <view class="motion-main-stat"><text class="motion-metric-label">累计距离 <text>公里</text></text><text class="motion-distance">{{track.distanceText}}</text></view>
        <view class="motion-main-stat duration-stat"><text class="motion-metric-label">运动时长</text><text class="motion-duration">{{track.durationText}}</text></view>
      </view>
      <view class="motion-extra-stats">
        <view><text class="motion-extra-value">{{track.speedText}} <text>km/h</text></text><text class="motion-extra-label">当前速度</text></view>
        <view><text class="motion-extra-value">{{track.averageSpeedText}} <text>km/h</text></text><text class="motion-extra-label">平均速度</text></view>
        <view><text class="motion-extra-value">{{track.pointCount}} <text>个</text></text><text class="motion-extra-label">轨迹点</text></view>
      </view>

      <view wx:if="{{track.errorMessage}}" class="motion-error"><text>!</text><text>{{track.errorMessage}}</text></view>
      <text class="motion-hint">{{track.hint}}</text>
      <text wx:if="{{track.saveMessage}}" class="motion-save-message">{{track.saveMessage}}</text>
      <button wx:if="{{track.canOpenSettings}}" class="motion-settings" bindtap="onOpenLocationSettings" hover-class="button-hover">打开定位设置 <text>↗</text></button>

      <button wx:if="{{track.nativeStopFailed}}" class="motion-stop-retry" bindtap="onFinishTrack" hover-class="button-hover">重试停止定位 <text>↻</text></button>
      <button wx:elif="{{track.status === 'idle'}}" class="motion-primary" bindtap="onStartTrack" hover-class="button-hover">开始记录 <text>↗</text></button>
      <view wx:elif="{{track.status === 'starting'}}" class="motion-controls"><button class="motion-primary" loading disabled>正在获取位置</button><button class="motion-secondary" bindtap="onPauseTrack" hover-class="button-hover">取消定位</button></view>
      <view wx:elif="{{track.status === 'recording'}}" class="motion-controls"><button class="motion-secondary" bindtap="onPauseTrack" hover-class="button-hover">暂停记录</button><button class="motion-primary" bindtap="onFinishTrack" hover-class="button-hover">结束运动</button></view>
      <view wx:elif="{{track.status === 'paused'}}" class="motion-controls"><button class="motion-primary" bindtap="onResumeTrack" hover-class="button-hover">继续记录</button><button class="motion-secondary" bindtap="onFinishTrack" hover-class="button-hover">结束运动</button></view>
      <button wx:elif="{{track.status === 'finished'}}" class="motion-primary" bindtap="onNewTrack" hover-class="button-hover">开始新的运动 <text>↗</text></button>
    </view>
    <text class="map-hint">开始记录后启用定位，结束后停止位置监听。</text>
  </view>

  <view class="friend-share-card">
    <section-heading eyebrow="TOGETHER / LIVE LOCATION" title="和好友共享位置" />
    <view class="friend-share-status"><text>{{friendShare.statusLabel}}</text><text>{{friendShare.expiresText}}</text></view>
    <text class="friend-share-hint">{{friendShare.hint}}</text>
    <view wx:if="{{friendShare.members.length}}" class="friend-share-members">
      <view wx:for="{{friendShare.members}}" wx:key="id" class="friend-share-member"><text>{{item.label}}</text><text>{{item.statusText}}</text></view>
    </view>
    <text wx:if="{{friendShare.errorMessage}}" class="friend-share-error">{{friendShare.errorMessage}}</text>
    <button wx:if="{{!friendShare.hasRoom}}" class="motion-primary" disabled="{{!friendShare.configured || friendShare.busy}}" loading="{{friendShare.busy}}" bindtap="onCreateFriendShare" hover-class="button-hover">创建并共享我的位置 <text>↗</text></button>
    <block wx:else>
      <button wx:if="{{friendShare.pendingStop}}" class="motion-stop-retry" disabled="{{friendShare.busy}}" bindtap="onPauseFriendShare" hover-class="button-hover">重试停止共享</button>
      <button wx:elif="{{friendShare.sharing}}" class="motion-secondary" disabled="{{friendShare.busy}}" bindtap="onPauseFriendShare" hover-class="button-hover">停止共享我的位置</button>
      <button wx:else class="motion-primary" disabled="{{friendShare.busy}}" loading="{{friendShare.busy}}" bindtap="onResumeFriendShare" hover-class="button-hover">开始共享我的位置</button>
      <view class="friend-share-actions"><button open-type="share" data-action="invite-room" disabled="{{!friendShare.canInvite || friendShare.busy}}" class="motion-secondary" hover-class="button-hover">邀请微信好友</button><button wx:if="{{friendShare.isOwner}}" bindtap="onCloseFriendShare" disabled="{{friendShare.busy}}" class="friend-share-close" hover-class="button-hover">结束全员共享</button></view>
    </block>
    <text class="friend-share-note">好友点击卡片加入同一张地图，各自开启后更新位置。邀请卡片可被转发，请仅发送给信任的人。</text>
  </view>

  <view class="ready-card">
    <view class="ready-top"><view class="ready-icon">✓</view><view class="ready-badge">READY TO BUILD</view></view>
    <text class="ready-title">基础框架已就绪</text>
    <text class="ready-description">页面、组件与服务，已经为你备好。</text>
    <view class="ready-bottom"><text>原生开发 · 轻量架构</text><text>v{{version}} ↗</text></view>
    <view class="orbit orbit-one"></view><view class="orbit orbit-two"></view>
  </view>

  <view class="stats-row"><view class="stat" wx:for="{{stats}}" wx:key="label"><text class="stat-value">{{item.value}}</text><text class="stat-label">{{item.label}}</text></view></view>

  <view class="section capabilities-section">
    <section-heading eyebrow="BUILT-IN CAPABILITIES" title="让开始更简单" action-text="组件示例" bind:action="onOpenComponents" />
    <view wx:if="{{errorMessage}}" class="error-card"><empty-state title="暂时没有连接上" description="{{errorMessage}}" action-text="重新加载" bind:action="onRetry" /></view>
    <view wx:else class="feature-grid">
      <view class="feature-card" wx:for="{{features}}" wx:key="id">
        <view class="feature-symbol {{item.tone}}">{{item.symbol}}</view>
        <text class="feature-title">{{item.title}}</text>
        <text class="feature-description">{{item.description}}</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loading-label">正在读取框架配置…</view>
  </view>

  <view class="request-card">
    <view class="request-title-row"><view class="code-icon">&lt;/&gt;</view><view class="request-copy"><text class="request-title">让数据跑起来</text><text class="request-description">{{mock ? '当前使用本地模拟数据，无需后端' : '当前使用已配置的 API 服务'}}</text></view></view>
    <button class="request-button" loading="{{requesting}}" disabled="{{requesting}}" bindtap="onTestRequest" hover-class="button-hover">{{requesting ? '请求中…' : '测试一次请求'}}<text wx:if="{{!requesting}}">→</text></button>
    <text wx:if="{{requestResult}}" class="request-result">{{requestResult}}</text>
  </view>

  <view class="guide-card"><view class="guide-index">01</view><view class="guide-body"><text class="guide-title">你的下一步，由你定义</text><text class="guide-description">从修改首页开始，构建你的第一个小程序。</text><button class="copy-link" bindtap="onCopyPath" hover-class="link-hover">复制页面路径 <text>↗</text></button></view></view>

  <view class="page-footer"><view class="footer-line"></view><text>小小起点，无限可能</text><view class="footer-line"></view></view>
</view>
