.empty-state { padding: 42rpx 24rpx 30rpx; text-align: center; }
.illustration { height: 112rpx; width: 132rpx; position: relative; margin: 0 auto 27rpx; }
.sheet { width: 75rpx; height: 91rpx; border: 2rpx solid #c9ddd2; border-radius: 12rpx; position: absolute; background: #f1f7f3; }
.sheet-back { transform: rotate(-15deg); top: 2rpx; left: 14rpx; }
.sheet-front { top: 11rpx; left: 35rpx; background: #fff; transform: rotate(9deg); }
.sheet-line { margin: 22rpx 13rpx 0; height: 5rpx; background: #d1e3d8; border-radius: 3rpx; }
.sheet-line.short { margin-top: 11rpx; width: 32rpx; }
.sheet-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #65b88e; margin: 12rpx 0 0 14rpx; }
.spark { position: absolute; font-size: 31rpx; color: #73b591; top: -8rpx; right: 1rpx; }
.title { display: block; color: #294137; font-size: 28rpx; font-weight: 500; }
.description { display: block; margin: 14rpx 0 0; color: #91a096; font-size: 23rpx; line-height: 1.7; }
.action { padding: 11rpx 26rpx; background: #edf6f0; border-radius: 13rpx; color: #398768; font-size: 23rpx; line-height: 1.5; display: inline-block; margin: 25rpx 0 0; }
.action::after { border: none; }
.action text { margin-left: 14rpx; }
.action-hover { opacity: .65; }
