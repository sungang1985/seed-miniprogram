<view class="heading">
  <view>
    <text wx:if="{{eyebrow}}" class="eyebrow">{{eyebrow}}</text>
    <text class="title">{{title}}</text>
  </view>
  <button wx:if="{{actionText}}" class="action" bindtap="onAction" hover-class="action-hover">{{actionText}} <text class="arrow">↗</text></button>
</view>
