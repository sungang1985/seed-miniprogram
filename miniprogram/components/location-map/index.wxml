<view class="location-card">
  <view class="map-viewport" style="height: {{mapHeight}}rpx;">
    <map
      wx:if="{{mapVisible}}"
      id="location-map"
      class="native-map"
      latitude="{{centerLatitude}}"
      longitude="{{centerLongitude}}"
      scale="{{currentScale}}"
      markers="{{markers}}"
      polyline="{{mapPolyline}}"
      show-location="{{false}}"
      show-compass="{{false}}"
      show-scale="{{true}}"
      enable-scroll="{{true}}"
      enable-zoom="{{true}}"
      enable-rotate="{{false}}"
      enable-overlooking="{{false}}"
      bindupdated="onMapUpdated"
      bindregionchange="onRegionChange"
      bindmarkertap="onMarkerTap"
      bindcallouttap="onMarkerTap"
    />
    <view wx:if="{{errorMessage}}" class="map-fallback">
      <view class="fallback-symbol">⌖</view>
      <text class="fallback-title">地图暂未就绪</text>
      <text class="fallback-description">{{errorMessage}}</text>
      <button class="retry-button" bindtap="onRetry" hover-class="button-hover">重新加载 ↻</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-status"><view class="status-dot"></view><text>正在加载地图…</text></view>

  <view class="location-info">
    <view class="place-marker">⌖</view>
    <view class="place-copy">
      <text class="place-title">{{displayTitle}}</text>
      <text wx:if="{{displayAddress}}" class="place-address">{{displayAddress}}</text>
    </view>
    <text class="place-tag {{tracking ? 'live-tag' : ''}}">{{placeTag}}</text>
  </view>

  <view class="map-actions">
    <view class="zoom-controls">
      <button class="zoom-button" bindtap="onZoomOut" disabled="{{loading || !mapVisible || currentScale === 3}}" aria-label="缩小地图" hover-class="button-hover">−</button>
      <text class="zoom-label">缩放</text>
      <button class="zoom-button" bindtap="onZoomIn" disabled="{{loading || !mapVisible || currentScale === 20}}" aria-label="放大地图" hover-class="button-hover">+</button>
    </view>
    <button class="recenter-button" bindtap="onRecenter" disabled="{{loading || !mapVisible || (tracking && !hasLiveLocation)}}" hover-class="button-hover">{{recenterLabel}} <text>↗</text></button>
  </view>
  <text wx:if="{{followMessage}}" class="follow-message">{{followMessage}}</text>
</view>
