.location-card { background: #fff; border: 1rpx solid #e3ece5; border-radius: 26rpx; overflow: hidden; }
.map-viewport { width: 100%; position: relative; background: #e9f1eb; }
.native-map { display: block; width: 100%; height: 100%; }
.map-fallback { box-sizing: border-box; width: 100%; height: 100%; padding: 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: #edf5ef; }
.fallback-symbol { color: #68997b; font-size: 64rpx; line-height: 1; margin-bottom: 22rpx; }
.fallback-title { color: #30543f; font-size: 29rpx; font-weight: 500; }
.fallback-description { margin-top: 12rpx; color: #7e9385; font-size: 23rpx; line-height: 1.7; }
.retry-button { margin: 22rpx 0 0; padding: 13rpx 26rpx; border-radius: 14rpx; background: #fff; color: #36805a; font-size: 23rpx; line-height: 1.5; }
.retry-button::after, .zoom-button::after, .recenter-button::after { border: 0; }
.loading-status { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 26rpx 0; color: #7b9483; font-size: 22rpx; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #7cb590; }
.location-info { display: flex; align-items: center; padding: 27rpx 26rpx 23rpx; }
.place-marker { flex-shrink: 0; width: 61rpx; height: 61rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #eaf6ee; color: #329168; font-size: 35rpx; margin-right: 19rpx; }
.place-copy { min-width: 0; flex: 1; }
.place-title { display: block; font-size: 28rpx; color: #294735; font-weight: 500; }
.place-address { display: block; font-size: 21rpx; color: #8e9c91; line-height: 1.6; margin-top: 5rpx; }
.place-tag { flex-shrink: 0; font-size: 18rpx; color: #7c9a85; background: #f0f6f1; padding: 5rpx 12rpx; border-radius: 9rpx; margin-left: 12rpx; }
.place-tag.live-tag { color: #078650; background: #e3f5e9; }
.follow-message { display: block; padding: 0 26rpx 22rpx; color: #9b784a; font-size: 21rpx; }
.map-actions { display: flex; justify-content: space-between; align-items: center; margin: 0 26rpx; padding: 19rpx 0 23rpx; border-top: 1rpx solid #edf1ed; }
.zoom-controls { display: flex; align-items: center; }
.zoom-button { display: flex; align-items: center; justify-content: center; width: 57rpx; height: 57rpx; padding: 0; margin: 0; line-height: 1; font-size: 35rpx; border-radius: 13rpx; background: #f0f6f1; color: #4c8a65; }
.zoom-label { font-size: 20rpx; color: #91a194; margin: 0 16rpx; }
.recenter-button { display: flex; align-items: center; padding: 10rpx 17rpx; margin: 0; color: #348760; background: #edf6f0; border-radius: 13rpx; font-size: 22rpx; line-height: 1.6; }
.recenter-button text { margin-left: 10rpx; }
.zoom-button[disabled], .recenter-button[disabled] { opacity: .45; color: #8ca292; background: #f2f5f2; }
.button-hover { opacity: .7; }
